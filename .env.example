# No quotes, no spaces around =. Use competition keys (not test keys).
ROOSTOO_API_KEY=your_competition_api_key
ROOSTOO_API_SECRET=your_competition_api_secret
ROOSTOO_BASE_URL=https://mock-api.roostoo.com

# V1: trade BTC only; others are market sensors (validated via exchangeInfo)
TRADE_PAIR=BTC/USD
WATCH_PAIRS=ETH/USD,SOL/USD,BNB/USD,XRP/USD,DOGE/USD,ADA/USD,AVAX/USD,LINK/USD

# 15m risk + execution; 1h strategy (SMA/breadth/score) updates on new closed 1h bar only
LOOP_SECONDS=900
STRATEGY_BAR_SECONDS=3600
SMA_FAST=5
SMA_SLOW=15
ATR_PERIOD=14
MAX_ABS_POSITION=0.50
MIN_POSITION_ADJUST=0.08
MIN_BREADTH_ASSETS=4
HTTP_TIMEOUT=15

# Anti-whipsaw
REQUIRE_CONFIRMED=true
FLIP_COOLDOWN_SECONDS=7200
MAX_STEP_FRACTION=0.15
