# No quotes, no spaces around =. Use competition keys (not test keys).
ROOSTOO_API_KEY=your_competition_api_key
ROOSTOO_API_SECRET=your_competition_api_secret
ROOSTOO_BASE_URL=https://mock-api.roostoo.com

# Trading
TRADE_PAIR=BTC/USD
# 300s bars => SMA_SLOW=15 needs ~75min live, but bot seeds ~45 historical 5m closes at start
LOOP_SECONDS=300
TARGET_FRACTION=0.20
SMA_FAST=5
SMA_SLOW=15
HTTP_TIMEOUT=15
